{
  "permissions": {
    "deny": [
      "Edit(/.git/**)"
    ],
    "ask": [
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-git.py"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
